{
    "name": "kornbip69/laravel-smart-migrations",
    "description": "A make:smart-migration Artisan command that infers columns from an Eloquent model, explicit --fields, or the migration name itself, with foreign-key guessing and duplicate-table guards.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "migrations", "artisan", "scaffolding", "codegen"],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SmartMigrations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmartMigrations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmartMigrations\\SmartMigrationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
