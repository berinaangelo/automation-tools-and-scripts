# Copy to terraform.tfvars and fill in for your system. terraform.tfvars is
# gitignored — never commit real account/project IDs or secrets in it.

cloud_provider = "aws"
project_name   = "load-balancer"
environment    = "dev"

tags = {
  ManagedBy = "terraform"
  Owner     = "your-name"
}

# --- AWS ---
aws_region        = "us-east-1"
aws_lb_type       = "application" # or "network"
aws_lb_internal   = false
aws_vpc_id        = "vpc-xxxxxxxx"                        # from the networking template's vpc_id output
aws_subnet_ids    = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"] # from the networking template's public_subnet_ids output
aws_security_group_ids = ["sg-xxxxxxxx"]                   # from the networking template's web_security_group_id output
aws_target_port     = 80
aws_target_protocol = "HTTP"
aws_health_check_path = "/"
aws_enable_https     = false
# aws_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."

# --- GCP ---
# gcp_project_id        = "my-gcp-project"
# gcp_region             = "us-central1"
# gcp_health_check_path  = "/"

# --- Azure ---
# azure_location = "eastus"
# azure_lb_sku   = "Standard"
